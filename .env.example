# RE:MEMORY — 可追蹤的空白範本，禁止填入實際金鑰。
# API Base URL 是否包含 /v1，依實際文件填寫。
MIXROUTE_BASE_URL=https://api.mixroute.ai/v1
MIXROUTE_API_KEY=
MIXROUTE_SMART_API_KEY=
# 以下認證格式為 OpenAI 相容預設，仍須核對實際入口文件。
MIXROUTE_AUTH_HEADER=Authorization
MIXROUTE_AUTH_SCHEME=Bearer
MIXROUTE_FIXED_MODEL=deepseek-v3.2
MIXROUTE_SMART_MODEL=auto
# 逗號分隔實際授權 Model ID。
MIXROUTE_AUTHORIZED_MODELS=
# Token 上限；Smart Routing 使用授權模型池中最低上限。
MIXROUTE_MODEL_CONTEXT_LIMIT=
# 所有授權模型輸入／輸出最高每百萬 Token 單價，USD。
MIXROUTE_MAX_USD_PER_MILLION=
# 空白代表 UNKNOWN；期限格式為 ISO 8601。
MIXROUTE_CREDIT_BALANCE_USD=
MIXROUTE_CREDIT_EXPIRES_AT=
MIXROUTE_DEV_BUDGET_USD=35
MIXROUTE_EMERGENCY_RESERVE_USD=15
MIXROUTE_TIMEOUT_SECONDS=30
MIXROUTE_MAX_RETRIES=1
MIXROUTE_ENABLED=false
APP_HOST=127.0.0.1
APP_PORT=8791
APP_TIMEZONE=Asia/Taipei
